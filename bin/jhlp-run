#!/usr/bin/env bash
# Every other file in this directory is a symlink to this script. It runs the function of ../lib/*.bash named like the symlink it was invoked through.
for lib in "$(dirname "$0")"/../lib/*.bash; do
  . "$lib"
done
name=$(basename "$0")
# Without a function of that name, bash would find this same symlink on PATH and call itself endlessly.
if [ "$(type -t "$name")" != function ]; then
  echo "jhlp-run: no function named $name in lib/" >&2
  exit 127
fi
"$name" "$@"
